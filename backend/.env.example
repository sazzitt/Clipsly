# Clipsly Backend Configuration (Local-Only Environment)
APP_NAME=Clipsly
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Host & Network (Strictly Localhost Loopback)
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Logging
# Defaults relative to repository root:
# DATA_DIR=data
# LOGS_DIR=logs
# STORAGE_DIR=storage
LOG_LEVEL=INFO
API_TIMEOUT_SECONDS=30

# Hardware & Model Configuration (RTX 3050 4GB VRAM)
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_COMPUTE_TYPE=float16
FORCE_CPU_TRANSCRIPTION=false
DEFAULT_VIDEO_ENCODER=h264_nvenc
MIN_FREE_DISK_SPACE_GB=10

# Optional External AI API Key (None by default)
# EXTERNAL_AI_API_KEY=
