# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true
ENVIRONMENT=development

# Storage Paths (Relative to project root)
DATA_DIR=data
STORAGE_DIR=storage
LOGS_DIR=logs
DATABASE_URL=sqlite+aiosqlite:///data/clipsly.db

# Hardware & Engine Settings
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_COMPUTE_TYPE=float16
FORCE_CPU_TRANSCRIPTION=false
DEFAULT_VIDEO_ENCODER=h264_nvenc
MIN_FREE_DISK_SPACE_GB=10

# Optional External AI Service Key (Disabled by default)
EXTERNAL_AI_API_KEY=
